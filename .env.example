# --- SprigaAPI integration ---------------------------------------------------
# Two supported modes:
#
# 1) Same-origin proxy (recommended when the API is on a different domain than
#    the frontend — avoids third-party-cookie blocking in Safari/Chrome/Firefox):
#      NEXT_PUBLIC_API_URL=/api                 # browser calls same-origin /api
#      API_PROXY_TARGET=https://spriga-api.essa.sx   # server-side forward target
#    The proxy lives in app/api/[...path]/route.ts and rewrites Set-Cookie to be
#    first-party.
#
# 2) Direct (only safe when frontend + API share a registrable domain, e.g.
#    app.example.com + api.example.com with a Domain=.example.com cookie):
#      NEXT_PUBLIC_API_URL=https://spriga-api.essa.sx

NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=https://spriga-api.essa.sx
